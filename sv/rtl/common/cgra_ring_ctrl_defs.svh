`ifndef CGRA_RING_CTRL_DEFS_SVH
`define CGRA_RING_CTRL_DEFS_SVH
// Public standalone API layout; independent of the four-input PE profile.
`define CGRA_RING_CTRL_PARAMETERS \
  parameter integer COLS=2, ROWS=2, DATA_W=32, DATA_ADDR_W=7, \
  parameter integer CTRL_DEPTH=8, REG_DEPTH=16, NUM_CTRL=4, TOTAL_STEPS=4, \
  parameter integer FU_INPUTS=4, FU_OUTPUTS=2, TILE_INPUTS=4, TILE_OUTPUTS=4, \
  parameter bit LEGACY_PYTHON=0, \
  localparam integer NUM_TILES=COLS*ROWS, ID_W=$clog2(NUM_TILES+1), \
  localparam integer ADDR_W=$clog2(CTRL_DEPTH), REG_W=$clog2(REG_DEPTH), \
  localparam integer FU_SEL_W=$clog2(FU_INPUTS+1), FU_OUT_W=$clog2(FU_OUTPUTS+1), \
  localparam integer ROUTES=TILE_OUTPUTS+FU_INPUTS, ROUTE_W=$clog2(TILE_INPUTS+FU_INPUTS+1), \
  localparam integer CTRL_BITS=11+FU_INPUTS*(FU_SEL_W+4+2*REG_W)+ROUTES*(ROUTE_W+FU_OUT_W), \
  localparam integer DATA_BITS=DATA_W+3, PAYLOAD_BITS=6+DATA_BITS+DATA_ADDR_W+CTRL_BITS+ADDR_W, \
  localparam integer PACKET_BITS=2*ID_W+15+PAYLOAD_BITS
`define CGRA_RING_CTRL_BIND \
  .COLS(COLS),.ROWS(ROWS),.DATA_W(DATA_W),.DATA_ADDR_W(DATA_ADDR_W), \
  .CTRL_DEPTH(CTRL_DEPTH),.REG_DEPTH(REG_DEPTH),.NUM_CTRL(NUM_CTRL),.TOTAL_STEPS(TOTAL_STEPS), \
  .FU_INPUTS(FU_INPUTS),.FU_OUTPUTS(FU_OUTPUTS),.TILE_INPUTS(TILE_INPUTS),.TILE_OUTPUTS(TILE_OUTPUTS), \
  .LEGACY_PYTHON(LEGACY_PYTHON)
`endif
